{
  "name": "tinycutlist",
  "version": "0.0.0",
  "private": true,
  "description": "TinyCutList: cut lists and cutting diagrams for Hew models.",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "cutlist": "node src/cli.ts",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:hew": "node --test \"test/hew/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "record": "node tools/record-fixtures.ts",
    "test:solver": "node --test \"test/solver/**/*.test.ts\"",
    "solver:build": "sh tools/solver-build.sh",
    "solver:fetch": "node tools/solver-fetch.ts",
    "plugin:build": "node tools/plugin-build.ts"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  },
  "bin": {
    "tinycutlist": "src/cli.ts"
  }
}
