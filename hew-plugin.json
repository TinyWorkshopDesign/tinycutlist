{
  "manifest": 1,
  "id": "io.github.tinyworkshopdesign.tinycutlist",
  "name": "TinyCutList",
  "version": "0.0.0",
  "description": "Cut lists and cutting diagrams for Hew models.",
  "author": {
    "name": "Michele Belleri (TinyWorkshopDesign)",
    "url": "https://github.com/TinyWorkshopDesign"
  },
  "license": "GPL-3.0",
  "source": "https://github.com/TinyWorkshopDesign/tinycutlist",
  "api": 1,
  "main": "background.js",
  "permissions": [
    "model.read"
  ],
  "activation": [
    "on_command"
  ],
  "contributes": {
    "commands": [
      {
        "id": "count_parts",
        "class": "read_only",
        "summary": "The model's parts: one row per closed solid, material, size and handedness, with glue-ups, open objects and look-alikes listed apart.",
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeHidden": {
              "type": "boolean"
            },
            "autoOrient": {
              "type": "boolean",
              "description": "longest extent first (default true)"
            },
            "types": {
              "type": "object",
              "description": "material name → type, for materials the model doesn't type",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "glueUps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "open": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "lookAlike": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "parts",
            "glueUps",
            "open",
            "lookAlike"
          ]
        }
      },
      {
        "id": "cut_list",
        "class": "read_only",
        "timeout_ms": 50000,
        "concurrency": "serial",
        "summary": "The model's cut list as Markdown, CSV, JSON or a printable HTML page, with cutting plans for sheets and bars (PackingSolver).",
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeHidden": {
              "type": "boolean"
            },
            "autoOrient": {
              "type": "boolean",
              "description": "longest extent first (default true)"
            },
            "types": {
              "type": "object",
              "description": "material name → type, for materials the model doesn't type",
              "additionalProperties": {
                "type": "string"
              }
            },
            "format": {
              "type": "string",
              "enum": [
                "md",
                "csv",
                "json",
                "html"
              ],
              "description": "md (default); html always has the cutting plans"
            },
            "plan": {
              "type": "boolean",
              "description": "add the cutting plans to md and json"
            },
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "stock": {
              "type": "object",
              "description": "material name → entry: {kind: sheet|bar|list, sheets?, bars?, kerf?, trim?, grain?, preset?}",
              "additionalProperties": {
                "type": "object"
              }
            },
            "sep": {
              "type": "string",
              "maxLength": 1
            },
            "decimal": {
              "type": "string",
              "maxLength": 1
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "text",
            "summary"
          ],
          "properties": {
            "format": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parts": {
                  "type": "integer"
                },
                "rows": {
                  "type": "integer"
                },
                "glueUps": {
                  "type": "integer"
                },
                "open": {
                  "type": "integer"
                },
                "sheets": {
                  "type": "integer"
                },
                "bars": {
                  "type": "integer"
                },
                "guessed": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      {
        "id": "get_stock",
        "class": "read_only",
        "summary": "The stock TinyCutList keeps for cutting plans: material name → sheets or bars.",
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stock"
          ],
          "properties": {
            "stock": {
              "type": "object",
              "description": "material name → entry: {kind: sheet|bar|list, sheets?, bars?, kerf?, trim?, grain?, preset?}",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        }
      },
      {
        "id": "set_stock",
        "class": "read_only",
        "summary": "Sets entries of the stock TinyCutList keeps (merged into it, unless merge is false). Changes the plugin's own data, never the model.",
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stock"
          ],
          "properties": {
            "stock": {
              "type": "object",
              "description": "material name → entry: {kind: sheet|bar|list, sheets?, bars?, kerf?, trim?, grain?, preset?}",
              "additionalProperties": {
                "type": "object"
              }
            },
            "merge": {
              "type": "boolean"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stock"
          ],
          "properties": {
            "stock": {
              "type": "object",
              "description": "material name → entry: {kind: sheet|bar|list, sheets?, bars?, kerf?, trim?, grain?, preset?}",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        }
      }
    ],
    "presave": false
  }
}
