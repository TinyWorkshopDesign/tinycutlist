{
  "manifest": 1,
  "id": "io.github.tinyworkshopdesign.tinycutlist",
  "name": "TinyCutList",
  "version": "0.0.0",
  "description": "Cut lists and cutting diagrams for Hew models.",
  "author": {
    "name": "Michele Belleri (TinyWorkshopDesign)",
    "url": "https://github.com/TinyWorkshopDesign"
  },
  "license": "GPL-3.0",
  "source": "https://github.com/TinyWorkshopDesign/tinycutlist",
  "hew": ">=1.5.0",
  "api": 1,
  "main": "dist/background.js",
  "permissions": [
    "model.read",
    "attributes.write"
  ],
  "activation": [
    "on_command",
    "on_surface_open",
    "on_document_has_namespace"
  ],
  "contributes": {
    "commands": [
      {
        "id": "count_parts",
        "class": "read_only",
        "summary": "The model's parts: one row per closed solid, material, size and handedness, with glue-ups, open objects and look-alikes listed apart.",
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includeHidden": {
              "type": "boolean"
            },
            "autoOrient": {
              "type": "boolean",
              "description": "longest extent first (default true)"
            },
            "types": {
              "type": "object",
              "description": "material name → type, for materials the model doesn't type",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "glueUps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "open": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "lookAlike": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "parts",
            "glueUps",
            "open",
            "lookAlike"
          ]
        }
      }
    ],
    "presave": false
  }
}
